# ============================================================
# 环境变量模板 —— 本文件**不参与构建**，只是字段说明。
# ------------------------------------------------------------
# 🔴 本仓只有三个 env 文件，不要再加第四个：
#
#    .env.example              ← 本文件。完整字段文档（模板，不参与构建）
#    .env.development          开发档，**已入库、团队共用**；
#                              默认「免登录 + 直连 Python」，
#                              「真实登录 + Node 中转」作为档位 B 写在它的注释里
#    .env.production.example   正式档模板 → 复制为 `.env.production` 使用（不入库）
#
# ---------- 为什么删掉了 `*.local` ----------
# 历史上用 `.env.development.local` 做"本机真实登录档"。它排在最后、
# **静默覆盖团队档** ⇒ 典型症状是「我明明改了 .env.development 却不起作用」。
# 现在要切档位就**直接改 .env.development**，冲突放在明面上。
#
# 🔴 Vite 只会把 `VITE_` 前缀的变量注入前端代码；不带前缀的不会进产物。
# 🔴 反过来说：**任何带 `VITE_` 前缀的值都会原样打进 JS 产物**，
#    浏览器里 F12 就能读到。绝对不要往里放密钥（LLM key、DB 密码、JWT secret）。
#    现有变量全是"地址"和"开关"，都符合这条。
#
# ---------- 注释写法 ----------
#   用 `#`。`//` 在 Vite 里**不是注释**，只是"变量名不合法的行"被忽略 ——
#   能跑但不规范，本仓已统一为 `#`。
#
# ---------- 改了不生效？三步自查 ----------
#   ① 必须**重启 dev server**（Vite 只在启动时读 env，没有热重载）；
#   ② 确认改的是 `.env.development` —— 本文件根本不参与构建；
#   ③ 确认没有残留的 `*.local` 文件（本仓已废弃该机制，见上）。
# ============================================================


# ============================================================
# ① 登录（VITE_AUTH_BYPASS）—— 二选一
# ------------------------------------------------------------
# true（开发默认）：
#   路由守卫全放行、注入 dev 用户、顶部显示橙色角标，
#   且**不创建登录 iframe、不发任何登录请求**。用于纯前端调试。
# false：
#   走真实登录 —— 弹窗内嵌 oauth21 的 `/mini-login` iframe，
#   登录成功后 bind-session 换本域 sid cookie，之后所有请求带凭据。
#   需要 oauth21 dev server（5174）与 Node 后端（3000）同时在跑。
#
# 🔴 生产必须为 false / 不设。开着等于把后台裸奔在公网。
# ============================================================
VITE_AUTH_BYPASS=true


# ============================================================
# ② 账号 / 会话服务（VITE_API_URL）
# ------------------------------------------------------------
# 未登录探活、登录换 cookie、任务持久化都打这个地址。
# 留空 → 走同源相对路径（由 vite proxy 转发到 3000，见 vite.config.ts）。
# 显式填 `http://127.0.0.1:3000` → **跨源**请求，
#   依赖 Node 侧 CORS_ORIGINS 放行本机 5177（且必须配 credentials）。
# 🔴 `localhost` 与 `127.0.0.1` 在 CORS 白名单里是**两条不同的 origin**。
# ============================================================
VITE_API_URL=http://localhost:3000


# ============================================================
# ③ oauth21 登录页（VITE_SSO_URL）
# ------------------------------------------------------------
# 登录 iframe 的地址。dev 起 5174；生产填实际域名。
# 🔴 换域名时**两边都要改**：
#    · 这里（宿主从哪个 origin 加载 iframe）
#    · oauth21 的 VITE_ALLOWED_PARENT_ORIGINS（iframe 只往白名单内的父窗口发消息）
#      漏改的症状：宿主等满 3 秒兜底超时才关 loading，控制台报
#      「[SSO] 拒绝 postMessage：父 origin 未授权」。
# ============================================================
VITE_SSO_URL=http://localhost:5174


# ============================================================
# ④ 算法服务走直连还是中转（VITE_RETRO_VIA_NODE）—— 二选一
# ------------------------------------------------------------
# 这个开关决定 `api/retro.ts` 里 `retroBaseURL` 取哪个值：
#
#   false（开发默认）：**直连 Python**
#       baseURL = VITE_RETRO_URL（下面 ⑤），dev 下是 `/retro`，
#       经 vite proxy 转发到 Flask 8000（rewrite `/retro` → `/api`）。
#       响应是**裸 JSON**，不做信封拆包。
#
#   true（生产建议）：**走 Node 中转**
#       baseURL = `${VITE_API_URL}/retroweb/v1`，响应是 Node 统一信封
#       `{ code, message, data }`（取 `data`）。好处：Python 从公网下线，
#       只在后端内网可见（Node 侧 `RETRO_PYTHON_URL`）；换来了按用户隔离的
#       LLM 配置（key 加密落库、官方 token 不回前端）。
#
# 🔴 两种走法下 `api/retro.ts` 的行为必须**一致**，已经对齐的有：
#    · 凭据：三个 axios client + SSE fetch 全部**无条件** `withCredentials`
#      / `credentials:'include'`（跨源不带 cookie ⇒ 登录了也 401）。
#    · 超时：predict/analyze 600s、轮询 20s、LLM 300s —— 与开关无关。
#    · 错误文案：同时认 Python 的 `{error}` 与 Node 的 `{message}`。
#      只认一个的症状是错误提示退化成干巴巴的「HTTP 502/401」。
#    · 401：两条出口都抛同一个 `createUnauthorizedError` 哨兵，
#      业务侧据此让位给登录流、且**不弹错误条**（否则登录前满屏红字）。
# ============================================================
VITE_RETRO_VIA_NODE=false


# ============================================================
# ⑤ 逆合成模型服务地址（VITE_RETRO_URL）
#       —— 只在 ④ 为 false 时生效
# ------------------------------------------------------------
# dev：留 `/retro`，由 vite proxy 转发到 127.0.0.1:8000（见 vite.config.ts）
# 生产：填后端实际地址，例如 https://retro.example.com/api
#
# 🔴 这是**前端请求的相对路径**，不是后端机器的地址。
#    想改"后端跑在哪台机器/哪个端口"，改 vite.config.ts 的 proxy 上游 ——
#    它可由环境变量 `DEV_RETRO_TARGET` 覆盖（**不带 VITE_ 前缀**，
#    只被 vite.config.ts 读取、不进前端产物）。
#
# 🔴 换成**跨域**地址时后端要同时放行前端 origin：
#    · Flask 侧：设置 RETRO_CORS_ORIGINS（见 F:\retrochimera\web\.env.example）
#    · Fastify 侧：oauth21 的 CORS_ORIGINS 要有前端 origin
# ============================================================
VITE_RETRO_URL=/retro


# ============================================================
# ⑥ 任务持久化走服务端（VITE_PERSIST_SERVER）
# ------------------------------------------------------------
# true：登录后任务的增删改查绑到 Node 后端（按用户隔离，换设备可见）；
#       未登录 / 离线自动回落到 localStorage。
# false（开发默认）：只用浏览器 localStorage。
#
# 🔴 它**不等于**"要不要登录"：为 true 但没登录时仍走本地。
#    要真实登录验证服务端持久化，必须同时 VITE_AUTH_BYPASS=false。
# ============================================================
VITE_PERSIST_SERVER=false


# ============================================================
# ⑦ dev 代理上游（DEV_API_TARGET / DEV_RETRO_TARGET）
# ------------------------------------------------------------
# 🔴 **刻意不带 `VITE_` 前缀** —— 它们只被 `vite.config.ts` 的 proxy 读取，
#    不该被打进前端产物（带 VITE_ 的值会原样进 JS bundle，F12 就能读到）。
#    vite.config.ts 用 `loadEnv(mode, ROOT, '')`（空前缀）来读取它们。
#
# 这两个是 **dev-only 的 proxy 上游地址**，改它们等于改
# "<后端跑在哪台机器>"，适用于：后端在另一台机 / 另一个端口 / Docker 映射。
#
# ⚠️ 只在**直连档**（VITE_RETRO_VIA_NODE=false）下 DEV_RETRO_TARGET 才有意义；
#    走 Node 中转时前端的 `/retro` 请求根本不会发出（改走 VITE_API_URL）。
#
# 不设时用内置默认：API 3000、RETRO 8000（与三件套的约定端口一致）。
#
#   写在哪：shell 环境变量，或（推荐）直接写在 `.env.development` 里 ——
#   `loadEnv(..., '')` 会连同非 VITE_ 变量一起读到。
# ============================================================
# DEV_API_TARGET=http://localhost:3000
# DEV_RETRO_TARGET=http://127.0.0.1:8000
