// ============================================================
// 开发环境：默认开启「免登录」（VITE_AUTH_BYPASS=true）
// ------------------------------------------------------------
// 免登录下：路由守卫全放行、注入 dev 用户、顶部显示橙色角标，
// 且**不创建登录 iframe、不发任何登录请求**。
// 想验证真实登录闭环，把下面这行改成 false（需同时跑 oauth21 dev server 5174 + 后端 3000）。
// ============================================================
VITE_AUTH_BYPASS=true

# 后端 API（Fastify 3000）；留空则走 vite proxy 同源相对路径
VITE_API_URL=http://localhost:3000

# oauth21 登录页（dev server）
VITE_SSO_URL=http://localhost:5174

# 逆合成模型服务（Flask 8000）；dev 走 /retro 代理，生产填实际地址
VITE_RETRO_URL=/retro
