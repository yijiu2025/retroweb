# ============================================================
# 开发档（例子）—— 本文件由 Vite 自动加载，**已入库、团队共用**
# ------------------------------------------------------------
# 🔴 三个 env 文件的分工（就这三个，不要再加）：
#    .env.example             完整字段文档（模板，不参与构建）
#    .env.development         **本文件** —— 开发档，已入库，团队共用
#    .env.production.example  正式档模板（复制为 .env.production 使用）
#
# ⚠️ 两种写法都生效，但语义不同：
#    `#`  —— 正式注释，Vite 会跳过该行。
#    `//` —— 本仓历史上用过，Vite 只认 `VITE_` 开头的行，`//` 行被当成
#            "没见过的变量名"忽略，**能跑但语义不干净**。本文件已统一为 `#`。
#
# ---------- 想临时切换档位 ----------
# 本文件默认给的是「免登录 + 直连 Python」——纯前端调试最省事：
#   不用起 oauth21(5174) 和 Node(3000)，只要 Python 算法服务(8000)在跑就能用。
# 需要验证「真实登录 + Node 中转」时，按下面「档位 B」把对应几行注释换掉即可。
# 🔴 改完要**重启 dev server**（Vite 只在启动时读 env）。
# ============================================================


# ============================================================
# 档位 A（当前生效）：免登录 + 直连 Python
#   —— 只要 8000 在跑；不起 5174 / 3000
# ============================================================

# 免登录：路由守卫全放行、注入 dev 用户、不创建登录 iframe
VITE_AUTH_BYPASS=true

# 账号服务（Fastify 3000）；留空则走 vite proxy 的同源相对路径
VITE_API_URL=http://localhost:3000

# oauth21 登录页（免登录下不会真的加载它，但地址仍要有值）
VITE_SSO_URL=http://localhost:5174

# 算法服务：直连 Python（dev 经 vite proxy 到 8000）
# 🔴 8000 这个**上游地址**在 vite.config.ts 里可由环境变量 DEV_RETRO_TARGET 覆盖
#    （不带 VITE_ 前缀 ⇒ 只被 proxy 读取、不进前端产物；换后端机器时用那个，
#     别改本文件的 VITE_RETRO_URL —— 它只是前端请求的相对路径）。
VITE_RETRO_VIA_NODE=false
VITE_RETRO_URL=/retro

# 持久化：只用浏览器 localStorage
VITE_PERSIST_SERVER=false


# ============================================================
# 档位 B（切换用）：真实登录 + Node 中转 + 服务端持久化
# ------------------------------------------------------------
# 切到这档需要**四个服务同时在线**：
#   · 5174 oauth21（登录 iframe）
#   · 5177 retroweb（本应用，即 vite 自己）
#   · 3000 Node 后端（换 cookie / 任务持久化 / /retroweb/v1 中转）
#   · 8000 Python 算法服务（被 Node 在**内网**转发，前端不再直连）
#
# 启用法：把上面「档位 A」的 5 行改成下面 5 行（其余不动）。
# ============================================================
# VITE_AUTH_BYPASS=false
# VITE_API_URL=http://127.0.0.1:3000
# VITE_SSO_URL=http://127.0.0.1:5174
# VITE_RETRO_VIA_NODE=true
# VITE_PERSIST_SERVER=true
#
# 🔴 档位 B 下 VITE_API_URL 用 `127.0.0.1` 而不是 `localhost`：
#    这是**跨源**请求（vite proxy 里没有 /retroweb 这条，见 vite.config.ts），
#    依赖 Node 侧 CORS_ORIGINS 放行本机 5177，且必须允许凭据
#    （否则登录后照样 401）。两个主机名在 CORS 白名单里是**两条不同的 origin**，
#    写错了会静默 401。
#
# 🔴 档位 B 下 VITE_RETRO_URL **完全不生效**（实际根为
#    `${VITE_API_URL}/retroweb/v1`），留着只是为了 A/B 切换时少改一行。
