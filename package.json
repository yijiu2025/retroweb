{
  "name": "retroweb",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "逆合成工作台前端（独立项目，登录走 oauth21 iframe SSO）",
  "license": "MIT",
  "author": "世间無晚風(*功) <https://github.com/yijiu2025/retroweb>",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview --port 5177 --strictPort",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:jsdoc": "node scripts/audit-jsdoc.cjs",
    "verify:readme": "node scripts/verify-readme.cjs",
    "verify:docs": "node scripts/check-docs-index.mjs docs",
    "verify:retro-envelope": "node scripts/verify-retro-envelope.cjs",
    "verify:ep-style": "node scripts/verify-ep-style.cjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test scripts/release-lib.test.mjs",
    "verify:interrupt": "node scripts/verify-interrupt.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@rdkit/rdkit": "^2026.9.1",
    "axios": "^1.20.0",
    "element-plus": "^2.14.6",
    "ketcher-core": "^3.14.0",
    "ketcher-react": "^3.14.0",
    "ketcher-standalone": "^3.14.0",
    "pinia": "^3.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
