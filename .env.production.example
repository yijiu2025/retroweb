# ============================================================
# 正式档模板 —— 复制为 `.env.production` 后按实际域名填写
# ------------------------------------------------------------
# 🔴 `.env.production` 由 `npm run build` 自动加载（已 gitignore，不入库）。
#    构建命令：`npm run build`（= type-check + vite build，mode 默认 production）。
#
# 🔴 这是本仓三个 env 文件中的第三个（另两个：`.env.example` 模板、
#    `.env.development` 开发档）。不要再用 `*.local` —— 它会静默覆盖，
#    详见 `.env.example` 顶部说明。
#
# ---------- 生产与开发的两个关键差异 ----------
#   ① VITE_AUTH_BYPASS **必须** false（不设即为 false，但显式写出来更安全）
#   ② VITE_RETRO_VIA_NODE 建议 true —— 让 Python 算法服务留在内网，
#      由 Node 后端经 RETRO_PYTHON_URL 转发；否则 Flask 得直接暴露公网。
# ============================================================

# 真实登录（不设也为 false，这里显式写出来防止被别处误开）
VITE_AUTH_BYPASS=false

# 账号 / 会话服务
VITE_API_URL=https://api.example.com

# oauth21 登录页
# 🔴 换域名时 oauth21 侧 VITE_ALLOWED_PARENT_ORIGINS 必须加上本应用 origin，
#    否则 iframe 的 postMessage 全被拒，宿主等满 3 秒兜底才关 loading。
VITE_SSO_URL=https://login.example.com

# 算法服务：走 Node 中转（Python 不出公网）
VITE_RETRO_VIA_NODE=true

# 仅当 VITE_RETRO_VIA_NODE=false（前端直连 Python）时才需要下面这条
VITE_RETRO_URL=https://retro.example.com/api

# 任务持久化绑用户
VITE_PERSIST_SERVER=true

# 前端是否有权启停模型（auto | on | off）
# 🔴 本档走 Node 中转 ⇒ auto 会判为「禁止」：**模型加载归 Node 管**，
#    前端只问"能不能用"，不给加载 / 停止 / 热挂正向模型的入口。
#    详见 .env.example 的 ⑧。
VITE_RETRO_MODEL_CONTROL=auto

# ⚠️ 生产构建**不需要** DEV_API_TARGET / DEV_RETRO_TARGET
#    （那两个只影响 `vite dev` 的 proxy，构建期完全用不到）。
